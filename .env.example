# Environment Configuration Template
PROJECT_NAME="Intelligent Document Extraction, Validation & API Platform"
ENVIRONMENT="production"
DEBUG=false

# API Prefix
API_V1_PREFIX="/api/v1"

# Database Configuration (SQLite by default, PostgreSQL for cloud deployment)
# Local SQLite:
DATABASE_URL="sqlite:///./data/documents.db"
# Cloud PostgreSQL example:
# DATABASE_URL="postgresql://user:password@hostname:5432/docintel_db"

# Storage Configuration
UPLOAD_DIR="./data/uploads"
MAX_FILE_SIZE_MB=25
MAX_PAGE_LIMIT=3

# AI & LLM Provider Keys (Optional: when provided, cloud LLM is prioritized)
# No actual secrets must be committed to git
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
LLM_MODEL="gemini-3.5-flash"

# Financial Validation Tolerance
FINANCIAL_TOLERANCE=0.05
ROUNDING_TOLERANCE_LARGE=1.0
